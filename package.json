{
  "name": "runway-ui",
  "version": "0.2.0",
  "description": "Modern HTML/CSS interface primitives for simulation and management games",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./styles/*": "./styles/*",
    "./dialog": {
      "types": "./behaviors/dialog.d.ts",
      "default": "./behaviors/dialog.js"
    },
    "./navigation": {
      "types": "./behaviors/navigation.d.ts",
      "default": "./behaviors/navigation.js"
    },
    "./inventory": {
      "types": "./behaviors/inventory.d.ts",
      "default": "./behaviors/inventory.js"
    },
    "./native.css": "./styles/native.css",
    "./bundle.css": "./dist/runway-ui.css",
    "./charts.css": "./styles/charts.css"
  },
  "files": [
    "index.css",
    "styles",
    "behaviors",
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "examples",
    "scripts"
  ],
  "style": "index.css",
  "license": "MIT",
  "author": "KahWee Teng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/runway-ui.git"
  },
  "homepage": "https://kahwee.github.io/runway-ui/",
  "bugs": {
    "url": "https://github.com/kahwee/runway-ui/issues"
  },
  "keywords": [
    "css",
    "html",
    "game-ui",
    "simulation",
    "management",
    "subgrid",
    "dialog",
    "inventory"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "build-site": "npm run build && npm run build-storybook && node scripts/build-site.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "marked": "18.1.1",
    "storybook": "10.6.3",
    "vite": "8.3.5"
  }
}
