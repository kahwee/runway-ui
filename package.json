{
  "name": "runway-ui",
  "version": "0.5.0",
  "description": "Modern HTML/CSS interface primitives for simulation and management games",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./styles/*": "./styles/*",
    "./dialog": {
      "types": "./behaviors/dialog.d.ts",
      "default": "./behaviors/dialog.js"
    },
    "./navigation": {
      "types": "./behaviors/navigation.d.ts",
      "default": "./behaviors/navigation.js"
    },
    "./inventory": {
      "types": "./behaviors/inventory.d.ts",
      "default": "./behaviors/inventory.js"
    },
    "./native.css": "./styles/native.css",
    "./bundle.css": "./dist/runway-ui.css",
    "./charts.css": "./styles/charts.css",
    "./dialog.css": "./styles/dialog.css",
    "./controls.css": "./styles/controls.css",
    "./fields.css": "./styles/fields.css",
    "./layout.css": "./styles/layout.css",
    "./history.css": "./styles/history.css",
    "./observatory.css": "./styles/observatory.css",
    "./forms": {
      "types": "./behaviors/forms.d.ts",
      "default": "./behaviors/forms.js"
    },
    "./timeseries": {
      "types": "./behaviors/timeseries.d.ts",
      "default": "./behaviors/timeseries.js"
    },
    "./history": {
      "types": "./behaviors/history.d.ts",
      "default": "./behaviors/history.js"
    },
    "./forms.css": "./styles/forms.css",
    "./icons.css": "./styles/icons.css",
    "./instruments.css": "./styles/instruments.css",
    "./workspace.css": "./styles/workspace.css",
    "./quiet.css": "./styles/quiet.css",
    "./studio.css": "./styles/studio.css"
  },
  "files": [
    "index.css",
    "styles",
    "behaviors",
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "examples",
    "scripts"
  ],
  "style": "index.css",
  "license": "MIT",
  "author": "KahWee Teng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/runway-ui.git"
  },
  "homepage": "https://kahwee.github.io/runway-ui/",
  "bugs": {
    "url": "https://github.com/kahwee/runway-ui/issues"
  },
  "keywords": [
    "css",
    "html",
    "game-ui",
    "simulation",
    "management",
    "subgrid",
    "dialog",
    "inventory"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "build-site": "pnpm run build && pnpm run build-storybook && node scripts/build-site.mjs",
    "check": "biome check --error-on-warnings .",
    "check-fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint --error-on-warnings ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "marked": "18.1.1",
    "storybook": "10.6.3",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.14.0"
}
