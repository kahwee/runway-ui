{
  "name": "runway-ui",
  "version": "0.5.0",
  "description": "Modern HTML/CSS interface primitives for simulation and management games",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./index.css",
    "./styles/*": "./styles/*",
    "./dialog": {
      "types": "./dist/behaviors/dialog.d.ts",
      "default": "./dist/behaviors/dialog.js"
    },
    "./navigation": {
      "types": "./dist/behaviors/navigation.d.ts",
      "default": "./dist/behaviors/navigation.js"
    },
    "./inventory": {
      "types": "./dist/behaviors/inventory.d.ts",
      "default": "./dist/behaviors/inventory.js"
    },
    "./native.css": "./styles/native.css",
    "./bundle.css": "./dist/runway-ui.css",
    "./charts.css": "./styles/charts.css",
    "./dialog.css": "./styles/dialog.css",
    "./controls.css": "./styles/controls.css",
    "./fields.css": "./styles/fields.css",
    "./layout.css": "./styles/layout.css",
    "./history.css": "./styles/history.css",
    "./observatory.css": "./styles/observatory.css",
    "./forms": {
      "types": "./dist/behaviors/forms.d.ts",
      "default": "./dist/behaviors/forms.js"
    },
    "./timeseries": {
      "types": "./dist/behaviors/timeseries.d.ts",
      "default": "./dist/behaviors/timeseries.js"
    },
    "./history": {
      "types": "./dist/behaviors/history.d.ts",
      "default": "./dist/behaviors/history.js"
    },
    "./forms.css": "./styles/forms.css",
    "./icons.css": "./styles/icons.css",
    "./instruments.css": "./styles/instruments.css",
    "./workspace.css": "./styles/workspace.css",
    "./quiet.css": "./styles/quiet.css",
    "./studio.css": "./styles/studio.css",
    "./resource": {
      "types": "./dist/behaviors/resource.d.ts",
      "default": "./dist/behaviors/resource.js"
    },
    "./styles": {
      "types": "./dist/behaviors/styles.d.ts",
      "default": "./dist/behaviors/styles.js"
    },
    "./actions": {
      "types": "./dist/behaviors/actions.d.ts",
      "default": "./dist/behaviors/actions.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "index.css",
    "styles",
    "behaviors",
    "dist",
    "LICENSE",
    "README.md",
    "docs",
    "examples",
    "scripts",
    "react"
  ],
  "style": "index.css",
  "license": "MIT",
  "author": "KahWee Teng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahwee/runway-ui.git"
  },
  "homepage": "https://kahwee.github.io/runway-ui/",
  "bugs": {
    "url": "https://github.com/kahwee/runway-ui/issues"
  },
  "keywords": [
    "css",
    "html",
    "game-ui",
    "simulation",
    "management",
    "subgrid",
    "dialog",
    "inventory"
  ],
  "scripts": {
    "build": "bun scripts/run-build.ts",
    "prepack": "bun run build",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build --disable-telemetry",
    "build-site": "bun run build && bun run build-storybook && bun scripts/build-site.ts",
    "check": "bun run lint && bun run check-types && bun run check-dependency-map",
    "check-fix": "bun fmt",
    "format": "bun fmt",
    "lint": "bun scripts/check-typescript-source.ts && bun run check-boundaries && bun fmt --check",
    "check-docs": "bun scripts/check-docs.ts",
    "check-generated": "bun scripts/check-generated.ts",
    "check-boundaries": "bun scripts/check-boundaries.ts",
    "test-dialog": "bun test ./tests/dialog.test.ts ./tests/dialog-stories.test.ts",
    "test-boundaries": "bun test ./tests/boundaries.test.ts",
    "test-behaviors": "bun scripts/build-runtime.ts && bun run build-types && bun run build-react-types && bun test ./tests/*.test.ts",
    "build-types": "bun scripts/build-types.ts",
    "check-types": "bun run build-types && bun run build-react-types && bun check --no-script -p tsconfig.behaviors.json && bun check --no-script -p tsconfig.react.json && bun check --no-script -p tsconfig.consumer.json && bun check --no-script -p tsconfig.stories.json && bun check --no-script -p tsconfig.tooling.json",
    "build-dependency-map": "bun scripts/build-dependency-map.ts",
    "check-dependency-map": "bun scripts/build-dependency-map.ts --check",
    "build-react-types": "bun scripts/build-react-types.ts",
    "clean": "bun scripts/clean.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/html-vite": "10.6.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "marked": "18.1.1",
    "parse5": "^8.0.1",
    "postcss": "^8.5.31",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild"
  ],
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@base-ui/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
