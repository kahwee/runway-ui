{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".types",
    "rootDir": "behaviors",
    "types": [],
    "skipLibCheck": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["behaviors/*.ts"],
  "exclude": ["behaviors/*.d.ts"]
}
